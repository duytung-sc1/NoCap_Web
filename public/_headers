/library
  X-Robots-Tag: noindex

/library/*
  X-Robots-Tag: noindex

/memory
  X-Robots-Tag: noindex

/memory/*
  X-Robots-Tag: noindex

/stats
  X-Robots-Tag: noindex

/stats/*
  X-Robots-Tag: noindex

/read/*
  X-Robots-Tag: noindex

/books/*
  X-Robots-Tag: noindex

/auth/*
  X-Robots-Tag: noindex
